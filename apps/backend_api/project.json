{
  "name": "backend-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "serve": {
      "command": "dotnet watch run --project apps/backend_api/backend_api.csproj --launch-profile http"
